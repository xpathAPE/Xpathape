# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upstay"

# --- App ---
# Public base URL of the deployment (used in storefront links + Stripe redirects)
APP_URL="http://localhost:3000"
# Secret for signing session JWTs (openssl rand -hex 32)
AUTH_SECRET="change-me"

# --- Stripe Connect ---
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Platform application fee on each upsell transaction (percent, 3-5 per spec)
PLATFORM_FEE_PERCENT="4"

# --- Messaging: Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Upstay <noreply@example.com>"

# --- Messaging: SMS (Twilio) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Cron (protects /api/cron/* dispatcher routes) ---
CRON_SECRET="change-me-too"
